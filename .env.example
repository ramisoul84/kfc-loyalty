# ─── Application ───
APP_NAME=kfc-loyalty
APP_ENV=development

# ─── Transports ───
HTTP_PORT=8004            # /health only
GRPC_PORT=9104

# ─── Logger ───
LOG_LEVEL=debug
LOG_FORMAT=text

# ─── Database ───
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=kfc_loyalty
DB_SSL_MODE=disable
DB_AUTO_MIGRATE=true

# ─── Kafka (order events drive earning and refunds) ───
KAFKA_BROKERS=localhost:29092
KAFKA_GROUP_ID=kfc-loyalty
KAFKA_ORDERS_TOPIC=orders.events

# ─── Program rules ───
LOYALTY_EARN_PERCENT=5          # points per 100 ₽ paid
LOYALTY_MAX_REDEEM_PERCENT=50   # max share of an order payable with points
LOYALTY_WELCOME_BONUS=100       # points on sign-up
LOYALTY_POINT_VALUE_KOPECKS=100 # 1 point = 1 ₽
LOYALTY_HOLD_TTL=15m            # checkout reservation lifetime
LOYALTY_CODE_TTL=5m             # kiosk code lifetime
